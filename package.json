{
  "name": "margin-blog",
  "version": "1.0.93",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node packaging/dev.mjs",
    "build": "npm run check:go && npm run build:web && npm run build:server",
    "test": "npm run test:node && npm run test:go && npm run test:backend",
    "build:binary": "npm run build && node packaging/build.mjs",
    "test:binary": "node packaging/smoke.mjs",
    "test:runtime-path": "node packaging/runtime-path-smoke.mjs",
    "lint": "npm run lint:web && npm run check:go",
    "build:web": "npm run generate:openapi && npm run lint:web && react-router typegen && tsc --noEmit && node packaging/build-web.mjs",
    "build:server": "go -C backend build -o ../artifacts/margin-server ./cmd/margin-server",
    "test:node": "tsx --test cli/*.test.ts src/*.test.ts src/blocks/*.test.ts && node --test packaging/offline-worker.test.mjs",
    "test:go": "go -C backend test -race ./... && go -C cli test -race ./...",
    "check:go": "go -C backend tool gocyclo -ignore third_party/ -over 10 . && go -C backend tool gocyclo -over 10 ../cli && go -C backend vet ./... && go -C cli vet ./...",
    "lint:web": "eslint src shared cli tests packaging examples *.ts --max-warnings 0",
    "test:frontend": "go -C backend test ./internal/blog -run \"PublicHTML|PublicDiscovery|WorkspaceHTML\"",
    "test:backend": "npm run build:server && node --import tsx tests/backend-contract.ts",
    "test:deploy": "node tests/deploy-proxy-smoke.mjs",
    "generate:openapi": "npm run generate:authoring && node packaging/generate-openapi.mjs",
    "check:openapi": "npm run check:authoring && node packaging/generate-openapi.mjs --check",
    "generate:authoring": "node --import tsx packaging/generate-authoring.ts",
    "check:authoring": "node --import tsx packaging/generate-authoring.ts --check"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/dancing-script": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/kalam": "^5.3.0",
    "@fontsource/lora": "^5.2.8",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@react-router/node": "^7.18.4",
    "diff": "^9.0.0",
    "highlight.js": "11.11.1",
    "hls.js": "^1.7.3",
    "isbot": "^5",
    "lucide-react": "^0.468.0",
    "mermaid": "^12.2.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "react-router": "^7.18.4",
    "rehype-sanitize": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "three": "^0.186.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@react-router/dev": "^7.18.4",
    "@types/node": "^24.7.1",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.186.0",
    "@typescript-eslint/parser": "^8.71.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "swagger-ui-dist": "5.33.3",
    "swagger2openapi": "7.0.8",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  },
  "engines": {
    "node": "^24.22.1"
  }
}
