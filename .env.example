# Optional release pin for Docker Compose.
# MARGIN_IMAGE=ghcr.io/writingmargin/margin:VERSION_TAG

# Local compose defaults. For public deployment set production and your HTTPS origin.
MARGIN_ENV=development
# Optional space-separated HTTPS origins for hosted interactive 3D models.
# MARGIN_MODEL_ORIGINS=https://models.example.com
# For npm run dev, use http://127.0.0.1:5173 and open that exact browser URL.
PUBLIC_URL=http://localhost:3001
# Any release image supports a subpath at runtime; no rebuild is needed.
# The mount defaults to PUBLIC_URL's path. MARGIN_BASE_PATH can override it.
# MARGIN_BASE_PATH=/blog
# PUBLIC_URL=https://usefused.com/blog
# Additional trusted browser origins, comma-separated (scheme + host + optional port).
# No paths or wildcards. PUBLIC_URL and the saved publication domain remain allowed.
# MARGIN_ALLOWED_ORIGINS=https://www.usefused.com,https://another-blog.example.com
# Owner and reader logins automatically share the HTTPS PUBLIC_URL domain and www alias.
# Optional override; use host-only to disable sharing. Local/HTTP URLs stay host-only.
# MARGIN_COOKIE_DOMAIN=usefused.com
PORT=3001
HOST=0.0.0.0
# Set only behind a trusted reverse proxy, to its exact hop count.
# TRUST_PROXY=1

# Optional override for the first-owner setup token. When empty, Margin generates
# and reuses .data/setup-token.secret (in the persistent volume with Compose).
# Read that file to enter the token when creating the first owner.
SETUP_TOKEN=

# Default metadata database (mount persistent storage).
SQLITE_PATH=.data/margin.db
# Optional external PostgreSQL; if set, selects PostgreSQL instead of SQLite.
# DATABASE_URL=postgresql://margin:CHANGE_ME@postgres:5432/margin

# Optional override: when empty, Margin generates and reuses
# .data/content-encryption-key.secret. Persist and back up the data directory.
# WARNING: changing this key without re-encryption loses access to previous data.
# For online rotation, keep the old key as the read-only fallback below.
# Switch all writers to the new key, run margin reencrypt, then --verify-only
# before retiring the fallback. See docs/storage-encryption.md for rolling upgrades.
CONTENT_ENCRYPTION_KEY=
# Optional read-only fallback during key rotation; new writes always use the primary.
# CONTENT_ENCRYPTION_KEY_PREVIOUS=

# Markdown is always stored in S3. Compose overrides endpoint to its Versity S3 service.
S3_BUCKET=margin-content
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=margin-local
S3_SECRET_ACCESS_KEY=change-this-local-storage-secret
# For AWS S3 remove S3_ENDPOINT, set S3_FORCE_PATH_STYLE=false and configure
# credentials here or use the AWS SDK default credential provider (e.g. IAM role).

# Configure CAPTCHA keys through Settings; they are stored encrypted in the database.

# Optional Cloudinary asset library and signed browser uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CLI: create a token in the signed-in owner's Settings screen.
MARGIN_URL=http://localhost:3001
MARGIN_TOKEN=

# Optional PostgreSQL service credentials for docker compose --profile postgres.
POSTGRES_PASSWORD=change-this-postgres-secret

# Optional pre-provisioned account key. Otherwise the owner creates an account
# with explicit consent in the workspace and its key is stored encrypted.
AI_SERVICE_TOKEN=
# Set only when moving an existing saved account to a new Central URL. It must
# exactly match the saved old URL; remove it after the new Central verifies the
# account and Margin updates the saved connection.
AI_SERVICE_URL_MIGRATE_FROM=
# Newsletter delivery is configured in Settings: Margin email or your own SMTP.
# SMTP credentials are encrypted with CONTENT_ENCRYPTION_KEY on this server.
# Provider API keys belong to Margin Central, never to individual blog engines.

# Optional publication-owner connections. See docs/publishing-connections.md.
MARGIN_GOOGLE_PUBLISHING_CLIENT_ID=
MARGIN_GOOGLE_PUBLISHING_CLIENT_SECRET=
MARGIN_LINKEDIN_PUBLISHING_CLIENT_ID=
MARGIN_LINKEDIN_PUBLISHING_CLIENT_SECRET=
