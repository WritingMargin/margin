                      "start",
                      "end"
                    ]
                  },
                  "maxWidth": {
                    "type": "integer",
                    "minimum": 160,
                    "maximum": 800
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
