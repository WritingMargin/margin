                            "latest",
                            "featured"
                          ]
                        },
                        "title": {
                          "anyOf": [
                            {
                              "type": "string",
                              "maxLength": 200
                            },
                            {
                              "type": "object",
                              "properties": {
                                "bind": {
                                  "type": "string",
                                  "enum": [
                                    "blog.title",
                                    "blog.description",
                                    "homepage.title",
                                    "homepage.description",
                                    "content.title",
                                    "content.description"
                                  ]
                                },
                                "fallback": {
                                  "type": "string",
                                  "maxLength": 200
                                }
                              },
                              "required": [
                                "bind"
                              ],
                              "additionalProperties": false
                            }
                          ]
                        },
                        "description": {
                          "anyOf": [
                            {
                              "type": "string",
                              "maxLength": 1000
                            },
                            {
                              "type": "object",
                              "properties": {
                                "bind": {
                                  "type": "string",
                                  "enum": [
                                    "blog.title",
                                    "blog.description",
                                    "homepage.title",
                                    "homepage.description",
                                    "content.title",
                                    "content.description"
                                  ]
                                },
                                "fallback": {
                                  "type": "string",
                                  "maxLength": 1000
                                }
                              },
                              "required": [
                                "bind"
                              ],
                              "additionalProperties": false
                            }
                          ]
                        },
                        "image": {
                          "anyOf": [
                            {
                              "type": "string",
                              "maxLength": 2048
                            },
                            {
                              "type": "object",
                              "properties": {
                                "bind": {
                                  "type": "string",
                                  "enum": [
                                    "blog.logo",
                                    "homepage.image",
                                    "content.cover"
                                  ]
                                },
                                "fallback": {
                                  "type": "string",
                                  "maxLength": 2048
                                }
                              },
                              "required": [
                                "bind"
                              ],
                              "additionalProperties": false
                            }
                          ]
                        },
                        "mediaType": {
                          "type": "string",
                          "enum": [
                            "image",
                            "video"
                          ]
                        },
                        "video": {
                          "type": "string",
                          "maxLength": 2048
                        },
                        "buttonLabel": {
                          "anyOf": [
                            {
                              "type": "string",
                              "maxLength": 80
                            },
                            {
                              "type": "object",
                              "properties": {
                                "bind": {
                                  "type": "string",
                                  "enum": [
                                    "blog.title",
                                    "blog.description",
                                    "homepage.title",
                                    "homepage.description",
                                    "content.title",
                                    "content.description"
                                  ]
                                },
                                "fallback": {
                                  "type": "string",
                                  "maxLength": 80
                                }
                              },
                              "required": [
                                "bind"
                              ],
                              "additionalProperties": false
