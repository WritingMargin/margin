                "maxLength": 80
              },
              "style": {
                "description": "Panel treatment. Omitted: outlined.",
                "type": "string",
                "enum": [
                  "plain",
                  "outlined",
                  "filled"
                ]
              },
              "numbered": {
                "description": "Number links in reading order. Omitted: false.",
                "type": "boolean"
              },
              "maxDepth": {
                "description": "Deepest heading level included: 2 includes H1 and H2. Omitted: 6.",
                "type": "integer",
                "minimum": 1,
                "maximum": 6
              },
              "sticky": {
                "description": "Keep sidebars visible while scrolling on desktop. Omitted: true.",
                "type": "boolean"
              },
              "width": {
                "description": "Desktop sidebar width in pixels. Omitted: 210.",
                "type": "integer",
                "minimum": 160,
                "maximum": 320
              },
              "radius": {
                "description": "Panel corner radius in pixels. Omitted: 8.",
                "type": "integer",
                "minimum": 0,
