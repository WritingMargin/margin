            "minItems": 1,
            "maxItems": 3,
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{0,63}$"
                    },
                    "component": {
                      "type": "string",
                      "const": "hero"
                    },
                    "variant": {
                      "type": "string",
                      "enum": [
                        "split",
                        "centered",
                        "image-background"
