{
  "formatVersion": 1,
  "format": "Margin storage/API design JSON (not the grouped editor export)",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "publicationType": {
        "type": "string",
        "enum": [
          "blog",
          "article",
          "research"
        ]
      },
      "footerTitle": {
        "type": "string",
        "maxLength": 150
      },
      "showFooterTitle": {
        "type": "boolean"
      },
      "showFooterLogo": {
        "type": "boolean"
      },
      "footerDescription": {
        "type": "string",
        "maxLength": 500
      },
      "footerLinks": {
        "maxItems": 8,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "url": {
              "type": "string",
              "maxLength": 2048
            }
          },
          "required": [
            "label",
            "url"
          ],
          "additionalProperties": false
        }
      },
      "footerLayout": {
        "type": "string",
        "enum": [
          "split",
          "stacked",
          "centered"
        ]
      },
      "footerBackground": {
        "anyOf": [
          {
            "type": "string",
            "const": ""
          },
          {
            "type": "string",
            "pattern": "^#[a-fA-F0-9]{6}$"
          }
        ]
      },
      "footerText": {
        "anyOf": [
          {
            "type": "string",
            "const": ""
          },
          {
            "type": "string",
            "pattern": "^#[a-fA-F0-9]{6}$"
          }
        ]
      },
      "footerFont": {
        "anyOf": [
          {
            "type": "string",
            "const": "inherit"
          },
          {
            "type": "string",
            "enum": [
              "serif",
              "sans",
              "source-serif",
              "playfair",
              "dm-sans",
              "plex-mono",
              "caveat",
              "kalam",
              "dancing-script",
              "oswald"
            ]
          }
        ]
      },
      "logo": {
        "type": "string",
        "maxLength": 2048
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "description": {
        "type": "string",
        "maxLength": 500
      },
      "accent": {
        "type": "string",
        "pattern": "^#[a-fA-F0-9]{6}$"
      },
      "background": {
        "type": "string",
        "pattern": "^#[a-fA-F0-9]{6}$"
      },
      "text": {
        "type": "string",
        "pattern": "^#[a-fA-F0-9]{6}$"
      },
